# Server-side only. Never prefix these values with VITE_ and never commit real values.
DATABASE_URL=
APP_ORIGIN=https://rat-monitor.vercel.app
SESSION_TOKEN_PEPPER=
AUTH_FINGERPRINT_KEY=

# Optional: leave blank to use the built-in timing-protection hash.
AUTH_DUMMY_PASSWORD_HASH=

# Server-side hardware authentication: JSON mapping registered device IDs to
# independent random base64url tokens (32–256 characters). Never use VITE_.
# Example shape only: {"RAT-TPE-001":"<device-specific-random-token>"}
MAP_SENSOR_TOKENS=

# Public build-time switch only. Use api after auth + map SQL migration and
# Vercel Functions are configured. demo persists map edits in this browser only.
VITE_MAP_DATA_MODE=demo

# Optional public tile provider; preserve the provider's required attribution.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=<a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>
